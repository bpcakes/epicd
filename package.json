{
  "name": "epicd",
  "version": "0.1.0",
  "description": "A durable Codex orchestrator for implementing and reviewing Beads epics.",
  "type": "module",
  "bin": {
    "epicd": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "dev": "npm run build && node dist/cli.js",
    "format": "prettier --write src test README.md package.json tsconfig.json tsconfig.test.json vitest.config.ts",
    "format:check": "prettier --check src test README.md package.json tsconfig.json tsconfig.test.json vitest.config.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "test:coverage": "vitest run --coverage",
    "test:fast": "vitest run --exclude 'test/**/*.integration.test.{ts,tsx}'",
    "test:integration": "vitest run .integration.test.",
    "test:live-codex": "vitest run test/codex-live.integration.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.153.4",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "effect": "4.0.0-rc.112",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@vitest/coverage-v8": "^5.0.1",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "license": "MIT"
}
